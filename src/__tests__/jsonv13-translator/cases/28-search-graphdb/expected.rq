SELECT DISTINCT ?Person_1 ?Text_1 WHERE {
  ?Person_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
  ?Person_1 <http://example.com/Person_fulltext> ?Text_1.
  ?Person_1 <http://www.ontotext.com/connectors/lucene#query> "text:mona lisa";
    <http://www.ontotext.com/connectors/lucene#entities> ?Text_1.
}
