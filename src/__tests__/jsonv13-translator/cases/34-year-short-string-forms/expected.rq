SELECT DISTINCT ?Person_1 WHERE {
  ?Person_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
  ?Person_1 <http://example.com/Person_birthYear> ?Date_1.
  FILTER((?Date_1 >= "0450-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>) && (?Date_1 <= "2023-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>))
}
