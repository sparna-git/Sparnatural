SELECT DISTINCT ?Person_1 ?Organization_1 ?Person_2 ?Organization_1_label WHERE {
  ?Person_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
  OPTIONAL {
    ?Person_1 <http://example.com/Person_memberOf> ?Organization_1.
    ?Organization_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Organization>.
    OPTIONAL {
      ?Organization_1 <http://example.com/Organization_name> ?Organization_1_label.
      FILTER((LANG(?Organization_1_label)) = "en")
    }
    ?Organization_1 <http://example.com/Organization_member> ?Person_2.
    ?Person_2 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
    FILTER(NOT EXISTS {
      ?Person_2 <http://example.com/Person_age> ?Number_1.
      FILTER(?Number_1 <= "30"^^<http://www.w3.org/2001/XMLSchema#decimal>)
    })
    SERVICE <https://query.wikidata.org/sparql> { ?Organization_1 <http://example.com/Organization_country> <http://example.com/country/FR>. }
  }
}
