SELECT DISTINCT ?Person_1 ?UntypedThing_1 ?Resource_1 ?Thing_1 WHERE {
  ?Person_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
  ?Person_1 <http://example.com/Person_thing> ?UntypedThing_1.
  ?Person_1 <http://example.com/Person_resource> ?Resource_1.
  ?Person_1 <http://example.com/Person_owlThing> ?Thing_1.
}
