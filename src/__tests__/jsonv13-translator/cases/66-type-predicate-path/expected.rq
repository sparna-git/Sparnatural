SELECT DISTINCT ?Person_1 ?Country_1 ?Country_1_label WHERE {
  ?Person_1 (<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>*)) <http://example.com/Person>.
  ?Person_1 <http://example.com/Person_country> ?Country_1.
  ?Country_1 (<http://www.w3.org/1999/02/22-rdf-syntax-ns#type>/(<http://www.w3.org/2000/01/rdf-schema#subClassOf>*)) <http://example.com/Country>.
  ?Country_1 <http://example.com/Country_label> ?Country_1_label.
}
