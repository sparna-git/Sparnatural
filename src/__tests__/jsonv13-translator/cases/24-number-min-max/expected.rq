SELECT DISTINCT ?Person_1 ?Number_1 WHERE {
  ?Person_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
  ?Person_1 <http://example.com/Person_age> ?Number_1.
  FILTER((?Number_1 >= "0"^^<http://www.w3.org/2001/XMLSchema#decimal>) && (?Number_1 <= "17.5"^^<http://www.w3.org/2001/XMLSchema#decimal>))
}
