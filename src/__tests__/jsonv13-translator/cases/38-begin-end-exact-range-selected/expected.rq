SELECT DISTINCT ?Person_1 ?Date_1_begin ?Date_1_end ?Date_1_exact WHERE {
  ?Person_1 <http://www.w3.org/1999/02/22-rdf-syntax-ns#type> <http://example.com/Person>.
  {
    ?Person_1 <http://example.com/activeExact> ?Date_1_exact.
    FILTER((?Date_1_exact >= "1800-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>) && (?Date_1_exact <= "1850-12-31T23:59:59Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>))
  }
  UNION
  {
    {
      ?Person_1 <http://example.com/activeBegin> ?Date_1_begin;
        <http://example.com/activeEnd> ?Date_1_end.
      FILTER(?Date_1_begin <= "1850-12-31T23:59:59Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>)
      FILTER(?Date_1_end >= "1800-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>)
    }
    UNION
    {
      ?Person_1 <http://example.com/activeBegin> ?Date_1_begin.
      FILTER(NOT EXISTS { ?Person_1 <http://example.com/activeEnd> ?Date_1_end. })
      FILTER(?Date_1_begin <= "1850-12-31T23:59:59Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>)
    }
    UNION
    {
      ?Person_1 <http://example.com/activeEnd> ?Date_1_end.
      FILTER(NOT EXISTS { ?Person_1 <http://example.com/activeBegin> ?Date_1_begin. })
      FILTER(?Date_1_end >= "1800-01-01T00:00:00Z"^^<http://www.w3.org/2001/XMLSchema#dateTime>)
    }
  }
}
