@prefix schema: <http://schema.org/> .
@prefix volipi: <http://data.sparna.fr/ontologies/volipi#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix wdt: <http://www.wikidata.org/prop/direct/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix skosthes: <http://purl.org/iso25964/skos-thes#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix qb: <http://purl.org/linked-data/cube#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix euvoc: <http://publications.europa.eu/ontology/euvoc#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix adms: <http://www.w3.org/ns/adms#> .
@prefix org: <http://www.w3.org/ns/org#> .
@prefix xls2rdf: <https://xls2rdf.sparna.fr/vocabulary#> .
@prefix this: <https://data.mydomain.com/ontologies/sparnatural-config/> .
@prefix dbpedia: <http://dbpedia.org/ontology/> .
@prefix odb: <http://example.com/ontology/odb#> .
@prefix core: <http://data.sparna.fr/ontologies/sparnatural-config-core#> .
@prefix dbp: <http://dbpedia.org/property/> .
@prefix datasources: <http://data.sparna.fr/ontologies/sparnatural-config-datasources#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix sparql: <http://www.w3.org/ns/sparql-service-description#> .
@prefix dc: <http://purl.org/dc/elements/1.1/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix skosxl: <http://www.w3.org/2008/05/skos-xl#> .
@prefix rico: <https://www.ica.org/standards/RiC/ontology#> .

<https://data.mydomain.com/ontologies/sparnatural-config> a owl:Ontology .

this:Place a sh:NodeShape;
  sh:targetClass rico:Place;
  sh:nodeKind sh:IRI;
  rdfs:label "Place"@en, "Lieu"@fr;
  sh:property this:Place_prefLabel, this:Place_type_list, this:Place_type_autocomplete, this:Place_type_tree, this:Place_type_tree_rec, this:Place_type_list_default, this:Place_type_autocomplete_default, this:Place_type_tree_default, this:isOrWasContainedBy_autocomplete_default .

this:PlaceType a sh:NodeShape;
  sh:targetClass rico:PlaceType;
  sh:nodeKind sh:IRI;
  rdfs:label "Place Type"@en, "Type de Lieu"@fr ;
  sh:property this:PlaceType_prefLabel.

this:Place_prefLabel sh:path skos:prefLabel;
  sh:name "pref label"@en, "libellé préférentiel"@fr;
  sh:nodeKind sh:Literal ;
  dash:propertyRole dash:LabelRole ;
  sh:datatype rdf:langString .

this:PlaceType_prefLabel sh:path skos:prefLabel;
  sh:name "pref label"@en, "libellé préférentiel"@fr;
  sh:nodeKind sh:Literal ;
  sh:datatype rdf:langString .


this:isOrWasContainedBy_autocomplete_default sh:path rico:isOrWasContainedBy;
  sh:name "était contenu dans (default autocomplete)"@fr, "is or was contained by (default autocomplete)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:Place;
  dash:searchWidget core:AutocompleteProperty;
.


this:Place_type_list_default sh:path rico:hasOrHadPlaceType;
  sh:name "place type (list - class template)"@en, "type de lieu (liste - class template)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:ListProperty;
  datasources:datasource <http://data.sparna.fr/ontologies/sparnatural-config-datasources#list_skospreflabel_alpha> .
  # datasources:datasource this:list_skospreflabel_alpha_defaultLang .
  # datasources:datasource <http://data.sparna.fr/ontologies/sparnatural-config-datasources#list_URI_or_literal_alpha> .

this:Place_type_autocomplete_default sh:path rico:hasOrHadPlaceType;
  sh:name "place type (autocomplete - class template)"@en, "type de lieu (autocomplete - class template)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:AutocompleteProperty;
  datasources:datasource <http://data.sparna.fr/ontologies/sparnatural-config-datasources#search_skospreflabel_contains> .

this:Place_type_list sh:path rico:hasOrHadPlaceType;
  sh:name "place type (list)"@en, "type de lieu (liste)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:ListProperty;
  datasources:datasource this:list_placetype_definition .
  # datasources:datasource this:list_placetype_definition_without_count_nothis .

this:Place_type_autocomplete sh:path rico:hasOrHadPlaceType;
  sh:name "place type (autocomplete)"@en, "type de lieu (autocomplete)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:AutocompleteProperty;
  datasources:datasource this:search_placetype_definition .

this:Place_type_tree sh:path rico:hasOrHadPlaceType;
  sh:name "place type direct (tree)"@en, "type de lieu direct (arbre)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:TreeProperty;
  datasources:treeRootsDatasource this:tree_root_placetype;
  datasources:treeChildrenDatasource this:tree_children_placetype .

this:Place_type_tree_rec
  sh:path (rico:hasOrHadPlaceType [ sh:zeroOrMorePath skos:broader ]);
  sh:name "place type indirect (tree)"@en, "type de lieu indirect (arbre)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:TreeProperty;
  datasources:treeRootsDatasource this:tree_root_placetype;
  datasources:treeChildrenDatasource this:tree_children_placetype .

this:Place_type_tree_default sh:path rico:hasOrHadPlaceType;
  sh:name "place type direct (tree - class template)"@en, "type de lieu direct (arbre - class template)"@fr;
  sh:nodeKind sh:IRI;
  sh:node this:PlaceType;
  dash:searchWidget core:TreeProperty;
  datasources:treeRootsDatasource this:tree_root_placetype;
  datasources:treeChildrenDatasource <http://data.sparna.fr/ontologies/sparnatural-config-datasources#tree_children_skosnarrower> .

# Les quatre datasources ci-dessous lisent skos:definition en plus du libelle,
# pour que la definition s'affiche sous le libelle dans les trois widgets.

this:list_placetype_definition a datasources:SparqlDatasource;
  datasources:noSort "true"^^xsd:boolean ;
  datasources:queryString """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT ?uri ?count ?description (CONCAT(STR(?theLabel), " (", STR(?count), ")") AS ?label) (STR(?theLabel) AS ?itemLabel) WHERE {
  {
    SELECT ?uri ?count ?theLabel WHERE {
      {
        SELECT DISTINCT ?uri (COUNT(?this) AS ?count) WHERE {
          ?this rdf:type $domain;
            $property ?uri.
          FILTER(ISIRI(?uri))
        }
        GROUP BY ?uri
      }
      OPTIONAL {
        ?uri skos:prefLabel ?theLabel1.
        FILTER(LANG(?theLabel1) = $lang)
      }
      OPTIONAL {
        ?uri skos:prefLabel ?theLabel2.
        FILTER(LANG(?theLabel2) = $defaultLang)
      }
      OPTIONAL {
        ?uri skos:prefLabel ?theLabel3.
        FILTER(LANG(?theLabel3) = "")
      }
      BIND(COALESCE(?theLabel1,?theLabel2,?theLabel3, "") AS ?theLabel)
      
    }
    ORDER BY DESC (?count) (UCASE(?theLabel))
    LIMIT 500
  }

  OPTIONAL {
    ?uri skos:definition ?description1.
    FILTER(LANG(?description1) = $lang)
  }
  OPTIONAL {
    ?uri skos:definition ?description2.
    FILTER(LANG(?description2) = $defaultLang)
  }
  OPTIONAL {
    ?uri skos:definition ?description3.
    FILTER(LANG(?description3) = "")
  }
  BIND(COALESCE(?description1,?description2,?tdescription3) AS ?description)

}
ORDER BY DESC (?count) (UCASE(STR(?label)))
  """;
.

this:list_placetype_definition_without_count a datasources:SparqlDatasource;
  datasources:noSort "true"^^xsd:boolean ;
  datasources:queryString """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
SELECT DISTINCT ?uri ?description (CONCAT(STR(?theLabel), " (xxx)") AS ?label) (STR(?theLabel) AS ?itemLabel) WHERE {
  
  ?this rdf:type $domain .
  ?this $property ?uri.

  ?uri rdf:type rico:PlaceType .
  FILTER(ISIRI(?uri))
  ?uri skos:prefLabel ?theLabel.
  FILTER(((LANG(?theLabel)) = "") || ((LANG(?theLabel)) = $lang))

  OPTIONAL {
    ?uri skos:definition ?description.
    FILTER(((LANG(?description)) = "") || ((LANG(?description)) = $lang))
  }
}
ORDER BY (UCASE(STR(?theLabel)))
  """;
.

this:list_placetype_definition_without_count_nothis a datasources:SparqlDatasource;
  datasources:noSort "true"^^xsd:boolean ;
  datasources:queryString """
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
SELECT DISTINCT ?uri ?description (CONCAT(STR(?theLabel), " (xxx)") AS ?label) (STR(?theLabel) AS ?itemLabel) WHERE {
  ?uri rdf:type rico:PlaceType .
  FILTER(ISIRI(?uri))
  ?uri skos:prefLabel ?theLabel.
  FILTER(((LANG(?theLabel)) = "") || ((LANG(?theLabel)) = $lang))

  OPTIONAL {
    ?uri skos:definition ?description.
    FILTER(((LANG(?description)) = "") || ((LANG(?description)) = $lang))
  }
}
ORDER BY (UCASE(STR(?theLabel)))
  """;
.

this:search_placetype_definition a datasources:SparqlDatasource;
  datasources:queryString """
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
SELECT DISTINCT ?uri ?label ?description WHERE {
  ?this $type $domain;
    $property ?uri.
  ?uri $type $range;
    skos:prefLabel ?label.
  FILTER(ISIRI(?uri))
  FILTER(((LANG(?label)) = "") || ((LANG(?label)) = $lang))
  FILTER(CONTAINS(LCASE(STR(?label)), LCASE("$key")))
  BIND(IF(STRSTARTS(LCASE(STR(?label)), LCASE("$key")), 0, 9) AS ?starts)
  OPTIONAL {
    ?uri skos:definition ?description.
    FILTER(((LANG(?description)) = "") || ((LANG(?description)) = $lang))
  }
}
ORDER BY ?starts (UCASE(STR(?label)))
LIMIT 15
  """;
.

this:tree_root_placetype a datasources:SparqlDatasource;
  datasources:queryString """
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
SELECT DISTINCT ?uri ?label ?description ?hasChildren (COUNT(DISTINCT ?this) AS ?count) WHERE {

  ?uri rdf:type rico:PlaceType .
  ?uri skos:prefLabel ?label.
  FILTER NOT EXISTS { ?parent skos:narrower|^skos:broader ?uri. }
  FILTER(ISIRI(?uri))
  FILTER(((LANG(?label)) = "") || ((LANG(?label)) = $lang))
  OPTIONAL { ?uri skos:narrower|^skos:broader ?children. }
  BIND(IF(BOUND(?children), true, false) AS ?hasChildren)
  OPTIONAL {
    ?uri skos:definition ?description.
    FILTER(((LANG(?description)) = "") || ((LANG(?description)) = $lang))
  }

  # Counts how many time the URI is used as value in the criteria build in Sparnatural
  OPTIONAL {
    ?this rdf:type $domain .
    ?this $property ?uri.
  }
}
GROUP BY ?uri ?label ?description ?hasChildren
ORDER BY (UCASE(STR(?label)))
  """;
.

this:tree_children_placetype a datasources:SparqlDatasource;
  datasources:queryString """
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rico: <https://www.ica.org/standards/RiC/ontology#>
SELECT DISTINCT ?uri ?label ?description ?hasChildren (COUNT(DISTINCT ?this) AS ?count) WHERE {


  $node skos:narrower|^skos:broader ?uri.
  ?uri skos:prefLabel ?label.
  FILTER(ISIRI(?uri))
  FILTER(((LANG(?label)) = "") || ((LANG(?label)) = $lang))
  OPTIONAL { ?uri skos:narrower|^skos:broader ?children. }
  BIND(IF(BOUND(?children), true, false) AS ?hasChildren)
  OPTIONAL {
    ?uri skos:definition ?description.
    FILTER(((LANG(?description)) = "") || ((LANG(?description)) = $lang))
  }

  # Counts how many time the URI is used as value in the criteria build in Sparnatural
  OPTIONAL {
    ?this rdf:type $domain .
    ?this $property ?uri.
  }
}
GROUP BY ?uri ?label ?description ?hasChildren
ORDER BY (UCASE(STR(?label)))
  """;
.
